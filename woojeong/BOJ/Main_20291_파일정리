import java.io.*;
import java.util.*;

public class Main_20291_파일정리 {
	public static void main(String[] args) throws Exception {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		
		int N = Integer.parseInt(br.readLine()); //버퍼리더에서 int형 입력 받기
		TreeMap<String, Integer> plus = new TreeMap<>();
		for(int i = 0; i<N; i++) {
			//확장자 split 뒤에 놈
			String file = br.readLine();
			String[] in = new String[2];
			in = file.split("\\."); //탈출문자 필요 
			
			
			plus.put(in[1], plus.getOrDefault(in[1], 0)+1);
		}
		
		for(String Key : plus.keySet()) {
			System.out.println(Key + " " + plus.get(Key));
		}
		
	}
}
